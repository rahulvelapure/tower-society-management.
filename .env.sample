MONGO_URI=
SECRET_KEY=
SESSION_SECRET=

# Optional but recommended in production: canonical application origin used for
# Stripe success/cancel redirects (e.g. https://two7east.onrender.com).
# Falls back to the request host when unset.
APP_BASE_URL=

# Stripe signed webhook secret (whsec_...) from the Stripe dashboard webhook
# endpoint for POST /webhooks/stripe. When unset, the webhook endpoint returns
# 503 and the verified /success redirect remains the payment recorder.
STRIPE_WEBHOOK_SECRET=

# Optional: outgoing email for password-reset links, notice alerts, etc.
# If left unset, emails are logged to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: override where uploaded files (attachments, receipts, etc.) are stored.
# Defaults to public/uploads. NOTE: Render's free-tier disk is ephemeral and is
# wiped on every deploy/restart - attach a Render persistent disk or migrate to
# cloud storage (Cloudinary/S3) before relying on uploads in production.
UPLOAD_DIR=