<%- include('partials/appHead', { pageTitle: 'Initialize Flat Master' }) %>
<%- include('partials/appNav', { active: 'flats', pageTitle: 'Initialize Flat Master' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Initialize Flat Master</h1>
    <div class="sub">Creates the canonical 112 residential flats from the confirmed tower structure.</div>
  </div>
  <a href="/units" class="btn btn-ghost">Back to flats</a>
</div>

<% if (result) { %>
  <div class="flash flash-success" style="max-width:640px;">Initialization complete.</div>
  <div class="card card-pad" style="max-width:640px;">
    <div class="eyebrow">Result</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Expected</dt><dd class="mono"><%= result.expected %></dd>
      <dt>Created</dt><dd class="mono"><%= result.created %></dd>
      <dt>Already existing</dt><dd class="mono"><%= result.alreadyExisting %></dd>
      <dt>Errors</dt><dd class="mono"><%= result.errors %></dd>
    </dl>
    <div class="mt-4">
      <a href="/units" class="btn btn-primary">View the tower</a>
    </div>
  </div>
<% } else { %>
  <div class="card card-pad" style="max-width:640px;">
    <div class="eyebrow">Tower configuration</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Residential floors</dt><dd>1 – 28</dd>
      <dt>Flats per floor</dt><dd>4</dd>
      <dt>Total residential flats</dt><dd>112</dd>
      <dt>Floor 29</dt><dd>Gym + Party Hall <span class="text-muted" style="font-weight:400;">(not residential)</span></dd>
      <dt>Floor 30</dt><dd>Terrace <span class="text-muted" style="font-weight:400;">(not residential)</span></dd>
    </dl>

    <hr class="divider">

    <p class="text-muted" style="font-size:14px;">
      This creates flats <b>101–104, 201–204, … 2801–2804</b>. It is safe to run more than once —
      existing flats are never modified or overwritten (resident links, occupancy and other details are preserved).
    </p>

    <% if (existingCount > 0) { %>
      <div class="flash flash-info"><%= existingCount %> unit(s) already exist. Running this only fills in missing canonical flats.</div>
    <% } %>

    <form action="/units/initialize" method="POST" onsubmit="return confirm('Initialize the 112-flat residential master now?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="flex gap-3">
        <button type="submit" class="btn btn-primary">Initialize 112 flats</button>
        <a href="/units" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
<% } %>

<%- include('partials/appFoot') %>
