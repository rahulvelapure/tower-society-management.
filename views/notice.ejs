<%- include('partials/appHead', { pageTitle: 'Post notice' }) %>
<%- include('partials/appNav', { active: 'notices', pageTitle: 'Post Notice' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Post a notice</h1>
    <div class="sub">Visible to every resident on the noticeboard.</div>
  </div>
  <a href="/noticeboard" class="btn btn-ghost">Back to noticeboard</a>
</div>

<div class="card card-pad" style="max-width:640px;">
  <form action="/notice" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label class="label" for="subject">Subject <span class="req">*</span></label>
      <input class="input" name="subject" id="subject" type="text" placeholder="e.g. Water supply maintenance on Saturday" required autofocus>
    </div>
    <div class="form-field">
      <label class="label" for="details">Details <span class="req">*</span></label>
      <textarea class="input" name="details" id="details" rows="7" placeholder="Write the full notice…" required></textarea>
    </div>
    <div class="flex gap-3 mt-4">
      <button type="submit" class="btn btn-primary">Publish notice</button>
      <a href="/noticeboard" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/appFoot') %>
