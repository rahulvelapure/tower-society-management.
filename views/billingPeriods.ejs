<%- include('partials/appHead', { pageTitle: 'Billing Periods' }) %>
<%- include('partials/appNav', { active: 'periods', pageTitle: 'Billing Periods' }) %>

<%
  function statusBadge(s) {
    if (s === 'DRAFT') return '<span class="badge badge-muted">Draft</span>';
    if (s === 'GENERATED') return '<span class="badge badge-warning">Generated</span>';
    if (s === 'ISSUED') return '<span class="badge badge-success">Issued</span>';
    return '<span class="badge badge-muted">Closed</span>';
  }
%>

<div class="page-header">
  <div>
    <h1 class="page-title">Billing periods</h1>
    <div class="sub">Explicit periods for maintenance billing — no bills are generated in this phase.</div>
  </div>
  <a href="/finance/periods/new" class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    Create period
  </a>
</div>

<% if (!periods.length) { %>
  <div class="card">
    <div class="empty-state">
      <div class="icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
      <div class="section-title">No billing periods yet</div>
      <p class="text-muted">Create your first period (e.g. July 2026) to get started.</p>
    </div>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Period</th><th>Dates</th><th>Issue / Due</th><th>Status</th></tr></thead>
      <tbody>
        <% periods.forEach(p => { %>
          <tr onclick="window.location='/finance/periods/<%= p._id %>'" style="cursor:pointer;">
            <td class="cell-strong"><%= p.name %></td>
            <td class="caption"><%= p.periodStart.toLocaleDateString() %> – <%= p.periodEnd.toLocaleDateString() %></td>
            <td class="caption"><%= p.issueDate ? p.issueDate.toLocaleDateString() : '—' %> / <%= p.dueDate ? p.dueDate.toLocaleDateString() : '—' %></td>
            <td><%- statusBadge(p.status) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/appFoot') %>
