<%- include('partials/appHead', { pageTitle: 'Bill Preview: ' + period.name }) %>
<%- include('partials/appNav', { active: 'periods', pageTitle: 'Bill Preview' }) %>

<%
  function formatAmount(paise) {
    const r = paise / 100;
    if (paise % 100 === 0) {
      return '₹' + r.toLocaleString('en-IN');
    } else {
      return '₹' + (r).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }
%>

<div class="page-header">
  <div>
    <div class="eyebrow">Bill Preview · FY <%= fy %></div>
    <h1 class="page-title" style="margin-top:4px;">Preview: <%= period.name %></h1>
    <div class="sub">Review what bills will be generated before committing.</div>
  </div>
  <a href="/finance/periods/<%= period._id %>" class="btn btn-ghost">Back to period</a>
</div>

<div class="grid cols-2">
  <div class="card card-pad">
    <div class="eyebrow">Summary</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Billing period</dt><dd><%= period.name %></dd>
      <dt>Issue date</dt><dd><%= new Date(period.issueDate).toLocaleDateString() %></dd>
      <dt>Due date</dt><dd><%= new Date(period.dueDate).toLocaleDateString() %></dd>
      <dt>Eligible units</dt><dd><%= preview.unitCount %></dd>
      <dt>Total to bill</dt><dd class="mono" style="font-size:16px; font-weight:600;"><%= formatAmount(preview.totalBilledPaise) %></dd>
    </dl>
  </div>

  <div class="card card-pad">
    <div class="eyebrow">Actions</div>
    <p class="text-muted" style="margin-top:10px; font-size:14px;">
      This is a preview only. No bills have been created yet.
    </p>
    <form action="/finance/periods/<%= period._id %>/generate" method="POST" style="margin-top:14px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary btn-block">Generate Draft Bills</button>
    </form>
    <p class="caption" style="margin-top:8px;">
      A small blue check mark will appear when you return to the period after generation is complete.
    </p>
  </div>
</div>

<div class="card mt-6">
  <div class="card-head"><h3>Per-unit breakdown</h3><span class="caption"><%= preview.unitCount %> flats</span></div>
  <div class="table-wrap" style="max-height:600px; overflow-y:auto;">
    <table class="table table-compact">
      <thead>
        <tr>
          <th>Flat</th>
          <th>Charges</th>
          <th class="num">Amount</th>
          <th class="num">Status</th>
        </tr>
      </thead>
      <tbody>
        <% preview.perUnitAnalysis.forEach((unit, idx) => { %>
          <tr>
            <td class="cell-strong"><%= unit.unit.flatNumber %> <span class="caption">Floor <%= unit.unit.floor %></span></td>
            <td>
              <% if (unit.lineItems.length === 0) { %>
                <span class="text-muted">—</span>
              <% } else { %>
                <% unit.lineItems.forEach((line, i) => { %>
                  <div style="font-size:13px; margin:<%= i > 0 ? '4px 0 0' : '0' %>;">
                    <%= line.label %> <span class="caption">(<%= line.code %>)</span>
                  </div>
                <% }) %>
              <% } %>
            </td>
            <td class="num mono">
              <% if (unit.lineItems.length === 0) { %>
                —
              <% } else { %>
                <%= formatAmount(unit.totalPaise) %>
              <% } %>
            </td>
            <td class="num">
              <% if (unit.issues.length === 0 && unit.lineItems.length > 0) { %>
                <span class="badge badge-success">Ready</span>
              <% } else if (unit.issues.length > 0) { %>
                <span class="badge badge-warning">Warning</span>
              <% } else { %>
                <span class="badge badge-muted">No charges</span>
              <% } %>
            </td>
          </tr>
          <% if (unit.issues.length > 0) { %>
            <tr style="background:rgba(0,0,0,0.02);">
              <td colspan="4" style="padding:8px 14px; font-size:12px; color:#666;">
                ⚠ <%= unit.issues.join('; ') %>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/appFoot') %>
