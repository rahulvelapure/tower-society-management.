<%- include('partials/appHead', { pageTitle: 'Edit profile' }) %>
<%- include('partials/appNav', { active: 'profile', pageTitle: 'Edit Profile' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Edit profile</h1>
    <div class="sub">Update your personal details<%= resident.isAdmin ? ' and society address' : '' %>.</div>
  </div>
  <a href="/profile" class="btn btn-ghost">Back to profile</a>
</div>

<div class="card card-pad" style="max-width:640px;">
  <form action="/editProfile" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="fieldset-title">Personal information</div>
    <div class="grid" style="grid-template-columns:1fr 1fr;">
      <div class="form-field">
        <label class="label" for="firstName">First name <span class="req">*</span></label>
        <input class="input" name="firstName" id="firstName" type="text" value="<%= resident.firstName %>" required autofocus>
      </div>
      <div class="form-field">
        <label class="label" for="lastName">Last name <span class="req">*</span></label>
        <input class="input" name="lastName" id="lastName" type="text" value="<%= resident.lastName %>" required>
      </div>
    </div>
    <div class="form-field">
      <label class="label" for="phoneNumber">Phone number <span class="req">*</span></label>
      <input class="input" name="phoneNumber" id="phoneNumber" type="tel" value="<%= resident.phoneNumber %>" required>
    </div>
    <div class="form-field">
      <label class="label" for="flatNumber">Flat number <span class="req">*</span></label>
      <input class="input" name="flatNumber" id="flatNumber" type="text" value="<%= resident.flatNumber %>" required>
      <div class="field-hint">Your authorized flat assignment is managed by the administrator.</div>
    </div>

    <% if (resident.isAdmin) { %>
      <div class="fieldset-title">Society address</div>
      <div class="form-field">
        <label class="label" for="societyAddress">Address <span class="req">*</span></label>
        <input class="input" name="address" id="societyAddress" type="text" value="<%= society.societyAddress.address %>" required>
      </div>
      <div class="grid" style="grid-template-columns:1fr 1fr;">
        <div class="form-field">
          <label class="label" for="city">City <span class="req">*</span></label>
          <input class="input" name="city" id="city" type="text" value="<%= society.societyAddress.city %>" required>
        </div>
        <div class="form-field">
          <label class="label" for="district">District <span class="req">*</span></label>
          <input class="input" name="district" id="district" type="text" value="<%= society.societyAddress.district %>" required>
        </div>
      </div>
      <div class="form-field">
        <label class="label" for="postalCode">Postal code <span class="req">*</span></label>
        <input class="input" name="postalCode" id="postalCode" type="text" value="<%= society.societyAddress.postalCode %>" required>
      </div>
    <% } %>

    <div class="flex gap-3 mt-4">
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a href="/profile" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/appFoot') %>
