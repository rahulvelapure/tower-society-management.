<%- include('partials/appHead', { pageTitle: 'Edit charges' }) %>
<%- include('partials/appNav', { active: 'bills', pageTitle: 'Edit Charges' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Maintenance charges</h1>
    <div class="sub">Monthly charge heads applied to every flat's bill.</div>
  </div>
  <a href="/bill" class="btn btn-ghost">Back to bills</a>
</div>

<div class="card card-pad" style="max-width:560px;">
  <form action="/editBill" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%
      const fields = [
        ['societyCharges', 'Society charges'],
        ['repairsAndMaintenance', 'Repairs and maintenance'],
        ['sinkingFund', 'Sinking fund'],
        ['waterCharges', 'Water charges'],
        ['insuranceCharges', 'Insurance charges'],
        ['parkingCharges', 'Parking charges']
      ];
    %>
    <% fields.forEach(([name, label], i) => { %>
      <div class="form-field">
        <label class="label" for="<%= name %>"><%= label %> (₹) <span class="req">*</span></label>
        <input class="input" name="<%= name %>" id="<%= name %>" type="number" min="0" value="<%= maintenanceBill[name] %>" required <%= i === 0 ? 'autofocus' : '' %>>
      </div>
    <% }) %>
    <div class="flex gap-3 mt-4">
      <button type="submit" class="btn btn-primary">Save charges</button>
      <a href="/bill" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/appFoot') %>
