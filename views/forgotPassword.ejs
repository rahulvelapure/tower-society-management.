<%- include('partials/appHead', { pageTitle: 'Forgot password' }) %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="wordmark">27<span class="accent">East</span></span>
      <span class="wordmark-tagline">Private Community Portal</span>
    </div>

    <div class="auth-welcome">
      <h1>Forgot password</h1>
      <p>Enter your email and we'll send a reset link.</p>
    </div>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="flash flash-info" style="margin-top:20px;"><%= message %></div>
    <% } %>

    <form class="auth-form" action="/forgot-password" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-field">
        <label class="label" for="email">Email</label>
        <input class="input" name="username" id="email" type="email" placeholder="you@example.com" autocomplete="username" required autofocus>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
    </form>

    <div style="text-align:center; margin-top:18px;"><a href="/login">Back to sign in</a></div>
    <div class="auth-foot"><%= brand.tagline %></div>
  </div>
</div>

</body>
</html>
