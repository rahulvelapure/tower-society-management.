<%- include('partials/appHead', { pageTitle: 'Flats' }) %>
<%- include('partials/appNav', { active: 'flats', pageTitle: 'Flats' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">The tower</h1>
    <div class="sub">112 residential flats across 28 floors. Floor 29 hosts the gym and party hall, floor 30 the terrace.</div>
  </div>
  <div class="flex gap-2 wrap">
    <a href="/units/new" class="btn btn-ghost">Add unit</a>
    <% if (stats.initialized < stats.total) { %>
      <a href="/units/initialize" class="btn btn-primary">Initialize Flat Master</a>
    <% } %>
  </div>
</div>

<div class="row-between wrap no-print" style="margin-bottom:20px; gap:12px;">
  <form method="GET" action="/units" class="flex gap-2" style="flex:1; max-width:320px;">
    <% if (occupancy) { %><input type="hidden" name="occupancy" value="<%= occupancy %>"><% } %>
    <input class="input" type="text" name="q" value="<%= q %>" placeholder="Search flat number…" inputmode="numeric">
    <button class="btn btn-ghost" type="submit">Search</button>
  </form>
  <div class="pills">
    <% const qParam = q ? '&q=' + encodeURIComponent(q) : ''; %>
    <a class="pill <%= !occupancy ? 'active' : '' %>" href="/units?<%= q ? 'q=' + encodeURIComponent(q) : '' %>">All</a>
    <a class="pill <%= occupancy === 'vacant' ? 'active' : '' %>" href="/units?occupancy=vacant<%= qParam %>">Vacant</a>
    <a class="pill <%= occupancy === 'owner-occupied' ? 'active' : '' %>" href="/units?occupancy=owner-occupied<%= qParam %>">Owner occupied</a>
    <a class="pill <%= occupancy === 'tenant-occupied' ? 'active' : '' %>" href="/units?occupancy=tenant-occupied<%= qParam %>">Tenant occupied</a>
  </div>
</div>

<div class="tower">
  <% if (!filtering) { %>
    <!-- Non-residential amenity floors: never assignable, shown for orientation -->
    <div class="floor-row amenity-row single">
      <div class="floor-label"><span class="fl">30</span><span class="cap">Floor</span></div>
      <div class="floor-units">
        <div class="amenity-tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          Terrace
        </div>
      </div>
    </div>
    <div class="floor-row amenity-row">
      <div class="floor-label"><span class="fl">29</span><span class="cap">Floor</span></div>
      <div class="floor-units">
        <div class="amenity-tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11"/></svg>
          Gym
        </div>
        <div class="amenity-tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22h8M12 11v11M12 11a5 5 0 0 0 5-5V2H7v4a5 5 0 0 0 5 5z"/></svg>
          Party Hall
        </div>
      </div>
    </div>
  <% } %>

  <% floors.forEach(row => { %>
    <div class="floor-row">
      <div class="floor-label"><span class="fl"><%= row.floor %></span><span class="cap">Floor</span></div>
      <div class="floor-units">
        <% row.slots.forEach(slot => { %>
          <% if (filtering && !slot.matches) { %>
            <div class="flat-tile empty-slot" style="opacity:.35;"><span class="flat-no text-faint"><%= slot.flatNumber %></span></div>
          <% } else if (!slot.unit) { %>
            <div class="flat-tile empty-slot" title="Not initialized yet">
              <span><%= slot.flatNumber %></span>
            </div>
          <% } else { %>
            <%
              const st = slot.unit.occupancyStatus || 'vacant';
              const cls = st === 'owner-occupied' ? 'owner' : (st === 'tenant-occupied' ? 'tenant' : 'vacant');
              const label = st === 'owner-occupied' ? 'Owner' : (st === 'tenant-occupied' ? 'Tenant' : 'Vacant');
            %>
            <a class="flat-tile <%= cls %>" href="/units/<%= slot.unit._id %>">
              <span class="flat-no"><%= slot.flatNumber %></span>
              <span class="flat-status"><span class="dot"></span><%= label %></span>
            </a>
          <% } %>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <% if (filtering && !floors.length) { %>
    <div class="card">
      <div class="empty-state">
        <div class="section-title">No flats match</div>
        <p class="text-muted">Try a different flat number or filter.</p>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/appFoot') %>
