<%- include('partials/appHead', { pageTitle: 'Profile' }) %>
<%- include('partials/appNav', { active: 'profile', pageTitle: 'Profile' }) %>

<%
  const initials = ((resident.firstName || ' ')[0] + (resident.lastName || ' ')[0]).toUpperCase();
  function occLabel(t) { return t ? t.charAt(0).toUpperCase() + t.slice(1) : null; }
%>

<div class="page-header">
  <div class="profile-hero">
    <span class="avatar-lg"><%= initials %></span>
    <div>
      <h2><%= resident.firstName %> <%= resident.lastName %></h2>
      <div class="sub">
        Flat <%= resident.unit ? resident.unit.flatNumber : resident.flatNumber %>
        · <%= resident.isAdmin ? 'Administrator' : 'Resident' %>
      </div>
    </div>
  </div>
  <a href="/editProfile" class="btn btn-primary">Edit profile</a>
</div>

<div class="grid cols-2">
  <div class="card card-pad">
    <div class="eyebrow">Contact information</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Email</dt><dd><%= resident.username %></dd>
      <dt>Phone</dt><dd class="mono"><%= resident.phoneNumber %></dd>
    </dl>

    <div class="eyebrow" style="margin-top:24px;">Residence</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Community</dt><dd><%= society.societyName %></dd>
      <dt>Flat</dt><dd class="mono"><%= resident.unit ? resident.unit.flatNumber : resident.flatNumber %></dd>
      <% if (resident.unit) { %><dt>Floor</dt><dd><%= resident.unit.floor %></dd><% } %>
      <% if (occLabel(resident.occupancyType)) { %><dt>Occupancy</dt><dd><%= occLabel(resident.occupancyType) %></dd><% } %>
    </dl>
  </div>

  <div class="card card-pad">
    <div class="eyebrow">Account</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Role</dt><dd><%= resident.isAdmin ? 'Administrator' : 'Resident' %></dd>
      <dt>Status</dt>
      <dd>
        <% if (resident.accountStatus === 'inactive') { %><span class="badge badge-danger"><span class="dot"></span>Inactive</span>
        <% } else if (resident.accountStatus === 'invited') { %><span class="badge badge-warning"><span class="dot"></span>Invitation pending</span>
        <% } else { %><span class="badge badge-success"><span class="dot"></span>Active</span><% } %>
      </dd>
      <dt>Member since</dt><dd><%= resident.createdAt ? new Date(resident.createdAt).toLocaleDateString() : '—' %></dd>
    </dl>

    <div class="eyebrow" style="margin-top:24px;">Society address</div>
    <dl class="def-list" style="margin-top:14px;">
      <dt>Address</dt><dd><%= society.societyAddress.address %></dd>
      <dt>City</dt><dd><%= society.societyAddress.city %></dd>
      <dt>District</dt><dd><%= society.societyAddress.district %></dd>
      <dt>Postal code</dt><dd class="mono"><%= society.societyAddress.postalCode %></dd>
    </dl>
  </div>
</div>

<%- include('partials/appFoot') %>
