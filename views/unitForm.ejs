<%- include('partials/appHead', { pageTitle: unit ? 'Edit flat' : 'Add flat' }) %>
<%- include('partials/appNav', { active: 'flats', pageTitle: unit ? 'Edit flat' : 'Add flat' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= unit ? 'Edit flat ' + unit.flatNumber : 'Add flat' %></h1>
    <div class="sub">Residential floors 1–28 only. Floors 29–30 are amenities.</div>
  </div>
  <a href="/units" class="btn btn-ghost">Back to flats</a>
</div>

<% if (typeof error !== 'undefined' && error) { %><div class="flash flash-error" style="max-width:640px;"><%= error %></div><% } %>

<div class="card card-pad" style="max-width:640px;">
  <form action="<%= unit ? '/units/' + unit._id : '/units' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="fieldset-title">Unit</div>
    <div class="grid" style="grid-template-columns:1fr 1fr;">
      <div class="form-field">
        <label class="label" for="floor">Floor (1–28) <span class="req">*</span></label>
        <input class="input" name="floor" id="floor" type="number" min="1" max="28" value="<%= unit ? unit.floor : '' %>" required>
      </div>
      <div class="form-field">
        <label class="label" for="flatNumber">Flat number <span class="req">*</span></label>
        <input class="input" name="flatNumber" id="flatNumber" type="text" value="<%= unit ? unit.flatNumber : '' %>" required>
      </div>
      <div class="form-field">
        <label class="label" for="unitType">Unit type</label>
        <select class="input" name="unitType" id="unitType">
          <% ['1BHK','2BHK','3BHK','4BHK','shop','office','other'].forEach(t => { %>
            <option value="<%= t %>" <%= unit && unit.unitType === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-field">
        <label class="label" for="areaSqft">Area (sqft)</label>
        <input class="input" name="areaSqft" id="areaSqft" type="number" min="0" value="<%= unit && unit.areaSqft ? unit.areaSqft : '' %>">
      </div>
    </div>
    <div class="form-field">
      <label class="label" for="occupancyStatus">Occupancy status</label>
      <select class="input" name="occupancyStatus" id="occupancyStatus">
        <% [['vacant','Vacant'],['owner-occupied','Owner occupied'],['tenant-occupied','Tenant occupied']].forEach(([v,l]) => { %>
          <option value="<%= v %>" <%= unit && unit.occupancyStatus === v ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
    </div>

    <div class="fieldset-title">Owner details</div>
    <div class="grid" style="grid-template-columns:1fr 1fr 1fr;">
      <div class="form-field">
        <label class="label">Name</label>
        <input class="input" name="ownerName" placeholder="Owner name" value="<%= unit && unit.owner ? unit.owner.name || '' : '' %>">
      </div>
      <div class="form-field">
        <label class="label">Phone</label>
        <input class="input" name="ownerPhone" type="tel" placeholder="Phone number" value="<%= unit && unit.owner ? unit.owner.phone || '' : '' %>">
      </div>
      <div class="form-field">
        <label class="label">Email</label>
        <input class="input" name="ownerEmail" type="email" placeholder="Email address" value="<%= unit && unit.owner ? unit.owner.email || '' : '' %>">
      </div>
    </div>

    <div class="fieldset-title">Tenant details (if applicable)</div>
    <div class="grid" style="grid-template-columns:1fr 1fr 1fr;">
      <div class="form-field">
        <label class="label">Name</label>
        <input class="input" name="tenantName" placeholder="Tenant name" value="<%= unit && unit.tenant ? unit.tenant.name || '' : '' %>">
      </div>
      <div class="form-field">
        <label class="label">Phone</label>
        <input class="input" name="tenantPhone" type="tel" placeholder="Phone number" value="<%= unit && unit.tenant ? unit.tenant.phone || '' : '' %>">
      </div>
      <div class="form-field">
        <label class="label">Email</label>
        <input class="input" name="tenantEmail" type="email" placeholder="Email address" value="<%= unit && unit.tenant ? unit.tenant.email || '' : '' %>">
      </div>
    </div>
    <div class="grid" style="grid-template-columns:1fr 1fr;">
      <div class="form-field">
        <label class="label" for="leaseStart">Lease start</label>
        <input class="input" name="leaseStart" id="leaseStart" type="date" value="<%= unit && unit.tenant && unit.tenant.leaseStart ? unit.tenant.leaseStart.toISOString().slice(0,10) : '' %>">
      </div>
      <div class="form-field">
        <label class="label" for="leaseEnd">Lease end</label>
        <input class="input" name="leaseEnd" id="leaseEnd" type="date" value="<%= unit && unit.tenant && unit.tenant.leaseEnd ? unit.tenant.leaseEnd.toISOString().slice(0,10) : '' %>">
      </div>
    </div>

    <div class="fieldset-title">Move dates</div>
    <div class="grid" style="grid-template-columns:1fr 1fr;">
      <div class="form-field">
        <label class="label" for="moveInDate">Move-in date</label>
        <input class="input" name="moveInDate" id="moveInDate" type="date" value="<%= unit && unit.moveInDate ? unit.moveInDate.toISOString().slice(0,10) : '' %>">
      </div>
      <div class="form-field">
        <label class="label" for="moveOutDate">Move-out date</label>
        <input class="input" name="moveOutDate" id="moveOutDate" type="date" value="<%= unit && unit.moveOutDate ? unit.moveOutDate.toISOString().slice(0,10) : '' %>">
      </div>
    </div>

    <div class="flex gap-3 mt-4">
      <button type="submit" class="btn btn-primary"><%= unit ? 'Save changes' : 'Create flat' %></button>
      <a href="/units" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/appFoot') %>
