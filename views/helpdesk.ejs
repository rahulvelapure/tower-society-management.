<%- include('partials/appHead', { pageTitle: 'Helpdesk' }) %>
<%- include('partials/appNav', { active: 'complaints', pageTitle: 'Helpdesk' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">My complaints</h1>
    <div class="sub">Raise and track maintenance requests.</div>
  </div>
  <a href="/complaint" class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    Raise complaint
  </a>
</div>

<div class="card card-pad">
  <% const realComplaints = complaints.filter(c => c && c.status); %>
  <% if (!realComplaints.length) { %>
    <div class="empty-state">
      <div class="icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
      <div class="section-title">No complaints raised</div>
      <p class="text-muted">Raise a complaint and track its resolution here.</p>
    </div>
  <% } else { %>
    <% realComplaints.slice().reverse().forEach(complaint => { %>
      <div class="ticket">
        <div class="ticket-body">
          <div class="row-between">
            <h4><%= complaint.category %></h4>
            <% if (complaint.status === 'open') { %>
              <span class="badge badge-warning"><span class="dot"></span>Open</span>
            <% } else { %>
              <span class="badge badge-success"><span class="dot"></span>Closed</span>
            <% } %>
          </div>
          <div class="meta"><%= complaint.date %><%= complaint.type ? ' · ' + complaint.type : '' %></div>
          <div class="text"><%= complaint.description %></div>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<%- include('partials/appFoot') %>
