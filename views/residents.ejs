<%- include('partials/appHead', { pageTitle: 'Residents' }) %>
<%- include('partials/appNav', { active: 'residents', pageTitle: 'Residents' }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Residents</h1>
    <div class="sub">Directory of <%= societyName %>.</div>
  </div>
  <% if (isAdmin) { %><a href="/members" class="btn btn-ghost">Manage members</a><% } %>
</div>

<% if (isAdmin && appliedResidents.length) { %>
  <div class="card" style="margin-bottom:20px;">
    <div class="card-head"><h3>Pending approvals</h3><span class="badge badge-warning"><%= appliedResidents.length %> waiting</span></div>
    <div class="card-pad">
      <form action="/approveResident" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="stack">
          <% appliedResidents.forEach(user => { %>
            <div class="row-between" style="border-bottom:1px solid var(--border); padding-bottom:12px;">
              <div>
                <div class="cell-strong"><%= user.firstName %> <%= user.lastName %></div>
                <div class="caption">Flat <%= user.flatNumber %></div>
              </div>
              <div class="flex gap-2">
                <button class="btn btn-success btn-sm" type="submit" name="validate[<%= user._id %>]" value="approved">Approve</button>
                <button class="btn btn-danger btn-sm" type="submit" name="validate[<%= user._id %>]" value="declined" onclick="return confirm('Decline this registration?');">Decline</button>
              </div>
            </div>
          <% }) %>
        </div>
      </form>
    </div>
  </div>
<% } %>

<% if (!societyResidents.length) { %>
  <div class="card">
    <div class="empty-state">
      <div class="icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
      <div class="section-title">No residents yet</div>
      <p class="text-muted">Approved residents will appear here.</p>
    </div>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Resident</th><th>Flat</th><th>Phone</th></tr></thead>
      <tbody>
        <% societyResidents.forEach(resident => { %>
          <tr>
            <td>
              <div class="flex gap-3" style="align-items:center;">
                <span class="avatar"><%= ((resident.firstName||' ')[0] + (resident.lastName||' ')[0]).toUpperCase() %></span>
                <span class="cell-strong"><%= resident.firstName %> <%= resident.lastName %></span>
              </div>
            </td>
            <td class="mono">
              <%= resident.flatNumber %>
              <% if (resident.unit) { %><span class="caption"> · Floor <%= resident.unit.floor %></span><% } %>
            </td>
            <td class="mono"><%= resident.phoneNumber %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/appFoot') %>
