<%- include('partials/appHead', { pageTitle: 'Complaints' }) %>
<%- include('partials/appNav', { active: 'complaints', pageTitle: 'Complaints' }) %>

<%
  let openCount = 0;
  users.forEach(u => (u.complaints || []).forEach(c => { if (c && c.status === 'open') openCount++; }));
%>

<div class="page-header">
  <div>
    <h1 class="page-title">Community complaints</h1>
    <div class="sub"><%= openCount %> open complaint<%= openCount === 1 ? '' : 's' %> awaiting resolution.</div>
  </div>
  <a href="/complaint" class="btn btn-ghost">Raise complaint</a>
</div>

<% if (!openCount) { %>
  <div class="card">
    <div class="empty-state">
      <div class="icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg></div>
      <div class="section-title">No open complaints</div>
      <p class="text-muted">All resident complaints have been resolved.</p>
    </div>
  </div>
<% } else { %>
  <form action="/closeTicket" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card card-pad">
      <% users.forEach(user => { %>
        <% (user.complaints || []).forEach((complaint, index) => { %>
          <% if (complaint && complaint.status === 'open') { %>
            <div class="ticket">
              <div class="ticket-body">
                <div class="row-between">
                  <h4><%= complaint.category %></h4>
                  <span class="badge badge-warning"><span class="dot"></span>Open</span>
                </div>
                <div class="meta"><%= complaint.date %><%= complaint.type ? ' · ' + complaint.type : '' %> · Raised by <%= user.firstName %> <%= user.lastName %> — Flat <%= user.flatNumber %></div>
                <div class="text"><%= complaint.description %></div>
                <div class="mt-2">
                  <button type="submit" name="ticket[<%= user._id %>]" value="<%= index %>" class="btn btn-success btn-sm" onclick="return confirm('Close this ticket?');">Close ticket</button>
                </div>
              </div>
            </div>
          <% } %>
        <% }) %>
      <% }) %>
    </div>
  </form>
<% } %>

<%- include('partials/appFoot') %>
