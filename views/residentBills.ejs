<%- include('partials/appHead', { pageTitle: 'My Bills' }) %>
<%- include('partials/appNav', { active: 'bill', pageTitle: 'My Bills' }) %>

<%
  function formatAmount(paise) {
    const r = paise / 100;
    if (paise % 100 === 0) {
      return '₹' + r.toLocaleString('en-IN');
    } else {
      return '₹' + (r).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }

  function statusText(status) {
    if (status === 'ISSUED') return 'Due';
    if (status === 'PARTIALLY_PAID') return 'Partial payment';
    if (status === 'PAID') return 'Paid';
    if (status === 'OVERDUE') return 'Overdue';
    return status;
  }

  function statusColor(status) {
    if (status === 'ISSUED') return 'badge-warning';
    if (status === 'PARTIALLY_PAID') return 'badge-info';
    if (status === 'PAID') return 'badge-success';
    if (status === 'OVERDUE') return 'badge-danger';
    return 'badge-muted';
  }
%>

<div class="page-header">
  <div>
    <div class="eyebrow">Finance</div>
    <h1 class="page-title" style="margin-top:4px;">My Bills</h1>
    <div class="sub">Outstanding and payment history</div>
  </div>
  <a href="/dashboard" class="btn btn-ghost">Back to home</a>
</div>

<% if (bills.length === 0) { %>
  <div class="card card-pad">
    <p class="text-muted">You're all paid up! No outstanding bills.</p>
  </div>
<% } else { %>
  <div class="grid cols-3" style="margin-bottom:24px;">
    <%
      const outstanding = bills.filter(b => b.status !== 'PAID').reduce((s, b) => s + (b.totalPaise - b.paidPaise), 0);
      const paid = bills.filter(b => b.status === 'PAID').length;
    %>
    <div class="card card-pad">
      <div class="eyebrow">Outstanding</div>
      <div class="kpi-value mono" style="margin-top:14px; font-size:20px; color:#d9534f;"><%= formatAmount(outstanding) %></div>
      <p class="caption">Amount due</p>
    </div>

    <div class="card card-pad">
      <div class="eyebrow">Bills</div>
      <div class="kpi-value" style="margin-top:14px;"><%= bills.length %></div>
      <p class="caption"><%= paid %> paid, <%= bills.length - paid %> due</p>
    </div>

    <div class="card card-pad">
      <div class="eyebrow">Payment</div>
      <% if (outstanding > 0) { %>
        <a href="/checkout-session" class="btn btn-primary btn-block" style="margin-top:10px;">Pay now</a>
        <p class="caption" style="margin-top:8px;">Online payment via credit/debit card</p>
      <% } else { %>
        <p class="text-muted" style="margin-top:10px;">No payment needed</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3>Bills</h3><span class="caption"><%= bills.length %> bill(s)</span></div>
    <div class="table-wrap">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Period</th>
            <th class="num">Amount</th>
            <th class="num">Paid</th>
            <th class="num">Due</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% bills.forEach(bill => { %>
            <tr>
              <td class="cell-strong">
                <% if (bill.period) { %><%= bill.period.name %><% } else { %>—<% } %>
              </td>
              <td class="num mono"><%= formatAmount(bill.totalPaise) %></td>
              <td class="num mono"><%= formatAmount(bill.paidPaise) %></td>
              <td class="num mono"><%= formatAmount(bill.totalPaise - bill.paidPaise) %></td>
              <td>
                <span class="badge <%= statusColor(bill.status) %>"><%= statusText(bill.status) %></span>
              </td>
              <td style="text-align:right; padding-right:14px;">
                <a href="/bill/<%= bill._id %>" class="link">View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('partials/appFoot') %>
