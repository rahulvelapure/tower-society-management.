<%- include('partials/appHead', { pageTitle: 'Notice' }) %>

<div class="auth-wrap">
  <div class="auth-card" style="text-align:center;">
    <div class="auth-brand" style="justify-content:center;">
      <span class="wordmark">27<span class="accent">East</span></span>
      <span class="wordmark-tagline">Private Community Portal</span>
    </div>

    <p style="margin-top:22px; color:var(--text); font-size:15px;"><%= message %></p>

    <a href="<%= href %>" class="btn btn-primary btn-block" style="margin-top:16px;">Try again</a>

    <% if (typeof messageSecondary !== 'undefined' && messageSecondary) { %>
      <p class="text-muted" style="margin-top:20px; font-size:13.5px;"><%= messageSecondary %></p>
      <a href="<%= hrefSecondary %>" class="btn btn-ghost btn-block"><%= buttonSecondary %></a>
    <% } %>
  </div>
</div>

</body>
</html>
