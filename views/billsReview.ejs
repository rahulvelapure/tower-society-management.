<%- include('partials/appHead', { pageTitle: 'Review Draft Bills: ' + period.name }) %>
<%- include('partials/appNav', { active: 'periods', pageTitle: 'Review Bills' }) %>

<%
  const isSuper = currentUser && (currentUser.role === 'superadmin' || (!currentUser.role && currentUser.isAdmin));

  function formatAmount(paise) {
    const r = paise / 100;
    if (paise % 100 === 0) {
      return '₹' + r.toLocaleString('en-IN');
    } else {
      return '₹' + (r).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }
%>

<div class="page-header">
  <div>
    <div class="eyebrow">Review Drafts · FY <%= fy %></div>
    <h1 class="page-title" style="margin-top:4px;">Draft Bills: <%= period.name %></h1>
    <div class="sub"><%= bills.length %> flat(s) with generated bill(s)</div>
  </div>
  <a href="/finance/periods/<%= period._id %>" class="btn btn-ghost">Back to period</a>
</div>

<% if (generated > 0) { %>
  <div class="flash flash-info">
    ✓ Generated <%= generated %> draft bill(s). Review below and then issue to make them visible to residents.
  </div>
<% } %>

<div class="grid cols-3">
  <div class="card card-pad">
    <div class="eyebrow">Bills</div>
    <div class="kpi-value" style="margin-top:14px;"><%= bills.length %></div>
    <p class="caption">Generated for this period</p>
  </div>

  <div class="card card-pad">
    <div class="eyebrow">Total amount</div>
    <div class="kpi-value mono" style="margin-top:14px; font-size:18px;"><%= formatAmount(totalBilledPaise) %></div>
    <p class="caption">All drafts combined</p>
  </div>

  <div class="card card-pad">
    <div class="eyebrow">Action</div>
    <% if (isSuper && bills.length > 0) { %>
      <form action="/finance/periods/<%= period._id %>/issue" method="POST" onsubmit="return confirm('Issue <%= bills.length %> bill(s) totaling <%= formatAmount(totalBilledPaise) %>? This will make them visible to residents and lock the amounts.');" style="margin-top:10px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-success btn-block">Issue Bills</button>
      </form>
      <p class="caption" style="margin-top:8px;">Superadmin only. Cannot be undone.</p>
    <% } else if (!isSuper) { %>
      <p class="text-muted" style="margin-top:10px; font-size:14px;">Superadmin must review and issue.</p>
    <% } else { %>
      <p class="text-muted" style="margin-top:10px; font-size:14px;">No bills to issue.</p>
    <% } %>
  </div>
</div>

<% if (bills.length === 0) { %>
  <div class="card mt-6 card-pad">
    <p class="text-muted">No bills generated yet. <a href="/finance/periods/<%= period._id %>">Go back</a> and generate bills first.</p>
  </div>
<% } else { %>
  <div class="card mt-6">
    <div class="card-head"><h3>Draft bills</h3><span class="caption">Status: DRAFT (not yet visible to residents)</span></div>
    <div class="table-wrap" style="max-height:600px; overflow-y:auto;">
      <table class="table table-compact">
        <thead>
          <tr>
            <th>Flat</th>
            <th>Charges</th>
            <th class="num">Amount</th>
            <th class="num">Status</th>
          </tr>
        </thead>
        <tbody>
          <% bills.forEach(bill => { %>
            <tr>
              <td class="cell-strong">
                <%= bill.unit.flatNumber %>
                <span class="caption">Floor <%= bill.unit.floor %></span>
              </td>
              <td>
                <% bill.lineItems.forEach((line, i) => { %>
                  <div style="font-size:13px; margin:<%= i > 0 ? '4px 0 0' : '0' %>;">
                    <%= line.label %>
                  </div>
                <% }) %>
              </td>
              <td class="num mono"><%= formatAmount(bill.totalPaise) %></td>
              <td class="num">
                <span class="badge badge-muted">DRAFT</span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('partials/appFoot') %>
