<!-- Resident signup / request access (single tower: 27 East) -->
<%- include('partials/headerForm') %>

  <body>
    <div class="container">
      <div class="row">
        <div class="col-sm-9 col-md-7 col-lg-5 mx-auto">
          <div class="card card-signin my-5">
            <div class="card-body">
              <h5 class="card-title text-center">Resident Sign Up</h5>
              <p class="text-center" style="margin-top:-10px; color:#555;">
                <%= society.societyName %>
              </p>
              <% if (typeof error !== 'undefined' && error) { %>
                <p style="color:#d9534f; text-align:center;"><%= error %></p>
              <% } %>
              <form class="form-signin" action="/signup" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-label-group">
                  <input name="firstName" type="text" id="inputFirstName" class="form-control" placeholder="First name" value="<%= prefill.firstName || '' %>" required autofocus>
                  <label for="inputFirstName">First name</label>
                </div>
                <div class="form-label-group">
                  <input name="lastName" type="text" id="inputLastName" class="form-control" placeholder="Last name" value="<%= prefill.lastName || '' %>" required>
                  <label for="inputLastName">Last name</label>
                </div>
                <div class="form-label-group">
                  <input name="phoneNumber" type="text" id="inputPhoneNumber" class="form-control" placeholder="Phone number" value="<%= prefill.phoneNumber || '' %>" required>
                  <label for="inputPhoneNumber">Phone number</label>
                </div>
                <div class="form-label-group">
                  <% if (units && units.length) { %>
                    <select name="unitId" id="inputFlat" class="form-control" required>
                      <option value="" disabled <%= prefill.unitId ? '' : 'selected' %>>Select your flat</option>
                      <% units.forEach(unit => { %>
                        <option value="<%= unit._id %>" <%= String(prefill.unitId) === String(unit._id) ? 'selected' : '' %>>
                          Floor <%= unit.floor %> &middot; Flat <%= unit.flatNumber %>
                        </option>
                      <% }) %>
                    </select>
                  <% } else { %>
                    <p style="color:#8a6d3b;">Flats have not been set up yet. Please contact your society administrator before registering.</p>
                  <% } %>
                </div>
                <div class="form-label-group">
                  <input name="username" type="email" id="email" class="form-control" placeholder="Email" value="<%= prefill.username || '' %>" required>
                  <label for="email">Email</label>
                </div>
                <div class="form-label-group">
                  <input name="password" type="password" id="inputPassword" class="form-control" placeholder="Password" minlength="8" required>
                  <label for="inputPassword">Password</label>
                </div>
                <button class="btn btn-lg btn-dark btn-block text-uppercase" type="submit" style="font-size:15px;" <%= (units && units.length) ? '' : 'disabled' %>>Request access</button>
                <hr class="my-4">
                <h6 class="card-text text-center">Already have an account?</h6>
                <a href="/login" class="btn btn-danger btn-block text-uppercase" style="font-size:15px;">Sign in</a>
                <a href="/" class="btn btn-secondary btn-block text-uppercase">Home</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>

</html>
